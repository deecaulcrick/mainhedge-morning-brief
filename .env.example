# Neon (serverless Postgres) connection string
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# Anthropic API key (extraction + synthesis)
ANTHROPIC_API_KEY=sk-ant-...

# Discord webhook URL for the channel you want the brief posted to
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: separate webhook for interrupt alerts (falls back to DISCORD_WEBHOOK_URL if unset)
DISCORD_INTERRUPT_WEBHOOK_URL=

# How the dashboard reads data. Two supported modes:
#   "db"  -> dashboard reads directly from Postgres (nothing else needed)
#   "api" -> this script POSTs the finished brief JSON to DASHBOARD_API_URL
DASHBOARD_MODE=db
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
